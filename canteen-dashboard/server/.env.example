# ── Required ──────────────────────────────────────────────────────────────────
PORT=3001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ── Email Alerts (optional) ───────────────────────────────────────────────────
# Leave blank to disable price-spike email alerts.
# Works with any SMTP provider: Gmail, Outlook, Mailgun, etc.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-app-password        # use an App Password, not your login password
#   ALERT_EMAIL_TO=manager@yourcompany.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
